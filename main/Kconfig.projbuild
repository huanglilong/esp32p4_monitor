menu "Monitor Example Configuration"

    choice BOARD_TYPE
        prompt "Select Board Type"
        default BOARD_WIFI6_TOUCH_LCD_4B
        help
            Select the target Waveshare ESP32-P4 development board.

        config BOARD_WIFI6_TOUCH_LCD_4B
            bool "ESP32-P4-WIFI6-Touch-LCD-4B"
            help
                Waveshare ESP32-P4-WIFI6-Touch-LCD-4B board with:
                - Onboard 4-inch 720x720 IPS LCD (ST7703) + GT911 touch
                - ES8311 DAC (0x30) + ES7210 ADC (0x80, dual-mic echo cancellation)
                - Optional Ethernet (IP101), RS485, Relay (ETH-2RO version)

        config BOARD_WIFI6
            bool "ESP32-P4-WIFI6"
            help
                Waveshare ESP32-P4-WIFI6 base board with:
                - MIPI DSI FPC connector (external display)
                - ES8311 single-chip audio (0x18, ADC+DAC) + NS4150B amp
                - Single SMD microphone
                - 40-Pin GPIO header (27 programmable GPIOs)
    endchoice

    choice EXAMPLE_MIPI_CSI_DISP_HRES
        bool "Set MIPI CSI horizontal resolution"
        default EXAMPLE_MIPI_CSI_HRES_800
        config EXAMPLE_MIPI_CSI_HRES_800
            bool "800"
    endchoice

    config EXAMPLE_MIPI_CSI_DISP_HRES
        int
        default 800 if EXAMPLE_MIPI_CSI_HRES_800

    choice EXAMPLE_MIPI_CSI_DISP_VRES
        bool "Set MIPI CSI vertical resolution"
        default EXAMPLE_MIPI_CSI_VRES_800
        config EXAMPLE_MIPI_CSI_VRES_800
            bool "800"
    endchoice

    config EXAMPLE_MIPI_CSI_DISP_VRES
        int
        default 800 if EXAMPLE_MIPI_CSI_VRES_800

    config EXAMPLE_USED_LDO_CHAN_ID
        int "CSI LDO channel ID"
        default 3
    config EXAMPLE_USED_LDO_VOLTAGE_MV
        int "CSI LDO voltage in mV"
        default 2500
        range 0 3300

    # SD Card
    config EXAMPLE_SDMMC_BUS_WIDTH_4
        bool "SDMMC 4-line mode"
        default y
    choice EXAMPLE_SDMMC_SPEED_MODE
        prompt "SD/MMC speed mode"
        default EXAMPLE_SDMMC_SPEED_DS
        config EXAMPLE_SDMMC_SPEED_DS
            bool "Default Speed"
        config EXAMPLE_SDMMC_SPEED_HS
            bool "High Speed"
    endchoice

    config EXAMPLE_PIN_CLK
        int "SDMMC CLK pin"
        default 43
    config EXAMPLE_PIN_CMD
        int "SDMMC CMD pin"
        default 44
    config EXAMPLE_PIN_D0
        int "SDMMC D0 pin"
        default 39
    config EXAMPLE_PIN_D1
        int "SDMMC D1 pin"
        default 40
    config EXAMPLE_PIN_D2
        int "SDMMC D2 pin"
        default 41
    config EXAMPLE_PIN_D3
        int "SDMMC D3 pin"
        default 42

    # Audio
    config EXAMPLE_VOICE_VOLUME
        int "Speaker output volume"
        default 80
        range 0 100
    config EXAMPLE_I2C_SCL_IO
        int "I2C SCL GPIO"
        default 8
    config EXAMPLE_I2C_SDA_IO
        int "I2C SDA GPIO"
        default 7
    config EXAMPLE_I2S_MCLK_IO
        int "I2S MCLK GPIO"
        default 13
    config EXAMPLE_I2S_BCLK_IO
        int "I2S BCLK GPIO"
        default 12
    config EXAMPLE_I2S_WS_IO
        int "I2S WS GPIO"
        default 10
    config EXAMPLE_I2S_DOUT_IO
        int "I2S DOUT GPIO"
        default 9
    config EXAMPLE_I2S_DIN_IO
        int "I2S DIN GPIO"
        default 11

endmenu
